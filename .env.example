# ULUMED Video Konferans - Environment Variables
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun

# Sunucu Port
PORT=8080

# Veritabanı Yolu (Render'da gerekli değil, lokal için)
DATABASE_PATH=./ulumed_uyeler.db

# TURN Server (Üretim için önerilir - coturn)
# Ücretsiz public STUN sunucuları kullanılabilir
STUN_SERVER=stun:stun.l.google.com:19302

# TURN Server (Opsiyonel - NAT traversal için)
# TURN_SERVER=turn:your-turn-server.com:3478
# TURN_USERNAME=your-username
# TURN_CREDENTIAL=your-credential

# CORS (Cross-Origin Resource Sharing)
# ULUMED uygulamasının çalıştığı domain
ALLOWED_ORIGINS=http://localhost:*

# Log Level
LOG_LEVEL=INFO
